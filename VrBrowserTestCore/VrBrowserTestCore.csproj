<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>icons8-vr-64.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);NU1504</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons8-vr-64.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Common.NETCore" Version="154.0.340" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="154.0.340" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="154.0.34" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x86" Version="154.0.34" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OVRSharp" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="FilterDesignerIjwhost" AfterTargets="_GatherDesignerShadowCopyFiles">
    <ItemGroup>
      <DesignerRuntimeImplementationProjectOutputGroupOutput
        Remove="@(DesignerRuntimeImplementationProjectOutputGroupOutput)"
        Condition="'%(Filename)%(Extension)' == 'Ijwhost.dll' and $([System.String]::Copy('%(FullPath)').Contains('win-arm64'))" />
      <DesignerRuntimeImplementationProjectOutputGroupOutput
        Remove="@(DesignerRuntimeImplementationProjectOutputGroupOutput)"
        Condition="'%(Filename)%(Extension)' == 'Ijwhost.dll' and '$(Platform)' != 'x86' and $([System.String]::Copy('%(FullPath)').Contains('win-x86'))" />
      <DesignerRuntimeImplementationProjectOutputGroupOutput
        Remove="@(DesignerRuntimeImplementationProjectOutputGroupOutput)"
        Condition="'%(Filename)%(Extension)' == 'Ijwhost.dll' and '$(Platform)' == 'x86' and $([System.String]::Copy('%(FullPath)').Contains('win-x64'))" />
    </ItemGroup>
  </Target>

</Project>
